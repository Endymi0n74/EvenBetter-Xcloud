{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "include": ["bench/**/*.js", "mobile/**/*.js", "src/**/*.js", "*.js", "*.mjs", "*.json"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noDebugger": "warn", "noConsoleLog": "off" },
      "correctness": { "noUnusedVariables": "warn" },
      "complexity": { "noForEach": "off" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "asNeeded" } },
  "overrides": [
    {
      "include": ["better-xcloud*.js", "better-xcloud*.meta.js"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    },
    {
      "include": ["bench/**/*.js", "mobile/**/*.js", "patches/**/*.js", "src/**/*.js"],
      "linter": { "rules": { "suspicious": { "noConsoleLog": "off", "noRedundantUseStrict": "off" }, "style": { "useNodejsImportProtocol": "off" } } }
    }
  ]
}
